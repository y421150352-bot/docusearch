# Backend
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

MYSQL_DATABASE=docusearch
MYSQL_USER=docusearch
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://docusearch:123456@127.0.0.1:3307/docusearch?charset=utf8mb4

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=docusearch_chunks
QDRANT_TIMEOUT=30

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_LOCAL_FILES_ONLY=false
USE_QDRANT_RETRIEVAL=true
USE_RERANKER=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_LOCAL_FILES_ONLY=false
RERANK_TOP_N=8
RERANK_CANDIDATE_TOP_K=30

CACHE_TTL_SECONDS=3600
TASK_STATUS_TTL_SECONDS=86400
